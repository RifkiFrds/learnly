# ===== Server =====
NODE_ENV=development
# Railway meng-inject PORT otomatis saat deploy
PORT=4000
# Origin FE yang diizinkan CORS, pisahkan dengan koma (mis. URL Vercel di production)
CORS_ORIGIN=http://localhost:3000
# URL publik API (untuk URL file saat STORAGE_DRIVER=local). Default: http://localhost:$PORT
API_PUBLIC_URL=http://localhost:4000
# URL web app — dipakai untuk link reset password & verifikasi email
WEB_APP_URL=http://localhost:3000

# ===== Database (MySQL) =====
# Lokal (docker-compose): mysql://root:learnly_root@localhost:3307/learnly
# Railway: referensikan variabel MYSQL_URL dari plugin MySQL
DATABASE_URL=mysql://root:learnly_root@localhost:3307/learnly

# ===== Auth (JWT) — minimal 32 karakter, generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# ===== File storage =====
# local = simpan di api/uploads (cukup untuk dev lokal); cloudinary = wajib untuk production
# (filesystem Railway tidak permanen — file hilang setiap redeploy)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===== Email (reset password & verifikasi email) =====
# log = isi email hanya dicetak ke console (dev); smtp = kirim via Gmail SMTP
MAIL_DRIVER=log
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
