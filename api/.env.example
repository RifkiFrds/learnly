# ===== Server =====
NODE_ENV=development
# Railway meng-inject PORT otomatis saat deploy
PORT=4000
# Origin FE yang diizinkan CORS, pisahkan dengan koma. Dengan proxy same-origin (rewrite Next.js) browser tidak
# memanggil API lintas domain; tetap isi URL Vercel agar akses langsung (mis. alat uji) & mode tanpa proxy berfungsi.
CORS_ORIGIN=http://localhost:3000
# SameSite cookie refresh token: lax (default, FE lewat proxy same-origin) | none (FE memanggil API langsung lintas domain)
COOKIE_SAME_SITE=lax
# Jumlah proxy di depan API: 1 = Railway saja; 2 = browser → Vercel (rewrite) → Railway (production)
TRUST_PROXY_HOPS=1
# Origin publik untuk URL file saat STORAGE_DRIVER=local. Isi origin WEB: file /uploads/* dilayani lewat
# proxy same-origin Next.js (rewrite ke API). Default bila kosong: http://localhost:$PORT (akses langsung ke API)
API_PUBLIC_URL=http://localhost:3000
# URL web app — dipakai untuk link reset password & verifikasi email
WEB_APP_URL=http://localhost:3000

# ===== Database (MySQL) =====
# Lokal (docker-compose): mysql://root:learnly_root@localhost:3307/learnly
# Railway: referensikan variabel MYSQL_URL dari plugin MySQL
DATABASE_URL=mysql://root:learnly_root@localhost:3307/learnly

# ===== Auth (JWT) — minimal 32 karakter, generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# ===== File storage =====
# local = simpan di api/uploads (cukup untuk dev lokal); cloudinary = wajib untuk production
# (filesystem Railway tidak permanen — file hilang setiap redeploy)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===== Email (reset password & verifikasi email) =====
# log = isi email hanya dicetak ke console (dev); smtp = kirim via Gmail SMTP
MAIL_DRIVER=log
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ===== Data demo =====
# Hanya untuk server production yang memang ingin diisi data demo (presentasi): node dist/scripts/demo-seed.js --reset
# ALLOW_DEMO_SEED=true
