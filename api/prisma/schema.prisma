// Learnly — Prisma schema (MySQL 8)
// Sumber kebenaran: docs/05-erd.md §3. Jika skema berubah, update dokumen ERD di commit yang sama.
//
// Konvensi:
// - Model PascalCase singular, field camelCase → @@map/@map ke tabel/kolom snake_case sesuai ERD.
// - Semua PK BIGINT UNSIGNED AUTO_INCREMENT (BigInt di TypeScript).
// - onDelete: Cascade hanya pada relasi kepemilikan murni; relasi transaksional memakai Restrict (lihat ERD §5).
// - Kolom polymorphic (payments.payable_id, reviews.reviewable_id) dan kolom audit
//   (booking_status_history.changed_by_user_id, assignment_submissions.graded_by_user_id) sengaja tanpa FK, sesuai DDL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================
// ENUMS
// =========================

enum UserRole {
  student
  parent
  tutor
  admin
}

enum UserStatus {
  active
  suspended
}

enum TeachingMode {
  online
  tatap_muka
  both
}

enum TutorVerificationStatus {
  pending_verification
  verified
  rejected
}

enum ServiceAreaType {
  area_name
  radius
}

enum BookingMode {
  online
  tatap_muka
}

enum BookingStatus {
  pending_confirmation
  rejected
  menunggu_pembayaran
  dikonfirmasi
  tutor_bersiap
  tutor_dalam_perjalanan
  tutor_tiba
  sesi_berlangsung
  sesi_selesai
  dibatalkan
}

enum CancelledBy {
  student
  tutor
  system
}

enum CourseLevel {
  pemula
  menengah
  lanjut
}

enum CourseStatus {
  draft
  in_review
  published
  archived
}

enum LessonType {
  video
  article
  quiz
  assignment
}

enum EnrollmentStatus {
  active
  completed
}

enum LessonProgressStatus {
  not_started
  in_progress
  completed
}

enum PayableType {
  booking
  course_enrollment
}

enum PaymentMethod {
  qris
  transfer_manual
}

enum PaymentStatus {
  menunggu_pembayaran
  menunggu_verifikasi
  paid
  ditolak
  expired
  refunded
}

enum ReviewableType {
  tutor_booking
  course
}

// =========================
// USERS & AUTH
// =========================

model User {
  id              BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  email           String     @unique @db.VarChar(191)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  fullName        String     @map("full_name") @db.VarChar(191)
  phone           String?    @db.VarChar(30)
  role            UserRole
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.DateTime(0)
  createdAt       DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  refreshTokens    RefreshToken[]
  learners         Learner[]
  addresses        Address[]
  tutorProfile     TutorProfile?
  notifications    Notification[]
  coursesCreated   Course[]       @relation("CourseCreatedBy")
  payments         Payment[]      @relation("PaymentUser")
  paymentsVerified Payment[]      @relation("PaymentVerifiedBy")
  reviews          Review[]

  @@index([role], map: "idx_users_role")
  @@map("users")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_user")
  @@map("refresh_tokens")
}

// =========================
// MASTER DATA
// =========================

model EducationLevel {
  id   BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  name String @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  learners             Learner[]
  tutorEducationLevels TutorEducationLevel[]
  courses              Course[]

  @@map("education_levels")
}

model Subject {
  id   BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  name String @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  tutorSubjects TutorSubject[]
  bookings      Booking[]

  @@map("subjects")
}

model Category {
  id   BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  name String @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  courses Course[]

  @@map("categories")
}

// =========================
// LEARNERS (student mandiri / anak dari parent)
// =========================

model Learner {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  ownerUserId      BigInt    @map("owner_user_id") @db.UnsignedBigInt
  fullName         String    @map("full_name") @db.VarChar(191)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  educationLevelId BigInt?   @map("education_level_id") @db.UnsignedBigInt
  isSelf           Boolean   @default(false) @map("is_self")
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  owner          User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  educationLevel EducationLevel?    @relation(fields: [educationLevelId], references: [id], onDelete: Restrict)
  bookings       Booking[]
  enrollments    CourseEnrollment[]

  @@index([ownerUserId], map: "idx_learners_owner")
  @@map("learners")
}

model Address {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt   @map("user_id") @db.UnsignedBigInt
  label       String   @db.VarChar(100)
  fullAddress String   @map("full_address") @db.VarChar(500)
  detailNote  String?  @map("detail_note") @db.VarChar(500)
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([userId], map: "idx_addresses_user")
  @@map("addresses")
}

// =========================
// TUTOR PROFILE
// =========================

model TutorProfile {
  id                      BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  userId                  BigInt                  @unique @map("user_id") @db.UnsignedBigInt
  bio                     String?                 @db.Text
  educationBackground     String?                 @map("education_background") @db.VarChar(255)
  teachingExperienceYears Int?                    @map("teaching_experience_years") @db.UnsignedSmallInt
  curriculum              String?                 @db.VarChar(255)
  hourlyRate              Decimal                 @default(0) @map("hourly_rate") @db.Decimal(12, 2)
  teachingMode            TeachingMode            @default(online) @map("teaching_mode")
  verificationStatus      TutorVerificationStatus @default(pending_verification) @map("verification_status")
  verificationNotes       String?                 @map("verification_notes") @db.VarChar(500)
  /// FR-BOOK-04: booking baru langsung diterima tanpa menunggu respons tutor
  autoAccept              Boolean                 @default(false) @map("auto_accept")
  avgRating               Decimal                 @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount             Int                     @default(0) @map("review_count") @db.UnsignedInt
  createdAt               DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt               DateTime                @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  certifications  TutorCertification[]
  subjects        TutorSubject[]
  educationLevels TutorEducationLevel[]
  serviceAreas    TutorServiceArea[]
  availabilities  TutorAvailability[]
  blockedDates    TutorBlockedDate[]
  bookings        Booking[]

  @@index([verificationStatus], map: "idx_tutor_verification")
  @@index([hourlyRate], map: "idx_tutor_rate")
  @@map("tutor_profiles")
}

model TutorCertification {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tutorProfileId BigInt    @map("tutor_profile_id") @db.UnsignedBigInt
  title          String    @db.VarChar(191)
  issuer         String?   @db.VarChar(191)
  fileUrl        String?   @map("file_url") @db.VarChar(500)
  issuedAt       DateTime? @map("issued_at") @db.Date

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@map("tutor_certifications")
}

model TutorSubject {
  tutorProfileId BigInt @map("tutor_profile_id") @db.UnsignedBigInt
  subjectId      BigInt @map("subject_id") @db.UnsignedBigInt

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([tutorProfileId, subjectId])
  @@map("tutor_subjects")
}

model TutorEducationLevel {
  tutorProfileId   BigInt @map("tutor_profile_id") @db.UnsignedBigInt
  educationLevelId BigInt @map("education_level_id") @db.UnsignedBigInt

  tutorProfile   TutorProfile   @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)

  @@id([tutorProfileId, educationLevelId])
  @@map("tutor_education_levels")
}

model TutorServiceArea {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  tutorProfileId  BigInt          @map("tutor_profile_id") @db.UnsignedBigInt
  areaType        ServiceAreaType @map("area_type")
  areaName        String?         @map("area_name") @db.VarChar(191)
  centerLatitude  Decimal?        @map("center_latitude") @db.Decimal(10, 7)
  centerLongitude Decimal?        @map("center_longitude") @db.Decimal(10, 7)
  radiusKm        Decimal?        @map("radius_km") @db.Decimal(6, 2)

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId], map: "idx_service_area_tutor")
  @@index([centerLatitude, centerLongitude], map: "idx_service_area_center")
  @@map("tutor_service_areas")
}

model TutorAvailability {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tutorProfileId BigInt   @map("tutor_profile_id") @db.UnsignedBigInt
  /// 0=Sunday .. 6=Saturday
  dayOfWeek      Int      @map("day_of_week") @db.UnsignedTinyInt
  startTime      DateTime @map("start_time") @db.Time(0)
  endTime        DateTime @map("end_time") @db.Time(0)

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId, dayOfWeek], map: "idx_availability_tutor")
  @@map("tutor_availabilities")
}

model TutorBlockedDate {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tutorProfileId BigInt   @map("tutor_profile_id") @db.UnsignedBigInt
  blockedDate    DateTime @map("blocked_date") @db.Date
  reason         String?  @db.VarChar(255)

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, blockedDate], map: "uq_tutor_blocked_date")
  @@map("tutor_blocked_dates")
}

// =========================
// BOOKINGS
// =========================

model Booking {
  id                 BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  learnerId          BigInt        @map("learner_id") @db.UnsignedBigInt
  tutorProfileId     BigInt        @map("tutor_profile_id") @db.UnsignedBigInt
  subjectId          BigInt        @map("subject_id") @db.UnsignedBigInt
  mode               BookingMode
  scheduledStartAt   DateTime      @map("scheduled_start_at") @db.DateTime(0)
  scheduledEndAt     DateTime      @map("scheduled_end_at") @db.DateTime(0)
  durationMinutes    Int           @map("duration_minutes") @db.UnsignedSmallInt
  addressId          BigInt?       @map("address_id") @db.UnsignedBigInt
  meetingLink        String?       @map("meeting_link") @db.VarChar(500)
  status             BookingStatus @default(pending_confirmation)
  hourlyRateSnapshot Decimal       @map("hourly_rate_snapshot") @db.Decimal(12, 2)
  serviceFee         Decimal       @default(0) @map("service_fee") @db.Decimal(12, 2)
  totalAmount        Decimal       @map("total_amount") @db.Decimal(12, 2)
  qrToken            String?       @map("qr_token") @db.VarChar(191)
  checkedInAt        DateTime?     @map("checked_in_at") @db.DateTime(0)
  checkedOutAt       DateTime?     @map("checked_out_at") @db.DateTime(0)
  cancelReason       String?       @map("cancel_reason") @db.VarChar(500)
  cancelledBy        CancelledBy?  @map("cancelled_by")
  createdAt          DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  learner        Learner                @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  tutorProfile   TutorProfile           @relation(fields: [tutorProfileId], references: [id], onDelete: Restrict)
  subject        Subject                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  address        Address?               @relation(fields: [addressId], references: [id], onDelete: Restrict)
  statusHistory  BookingStatusHistory[]
  tutorLocations TutorLocation[]
  progressReport ProgressReport?

  @@index([tutorProfileId, scheduledStartAt], map: "idx_bookings_tutor_time")
  @@index([learnerId], map: "idx_bookings_learner")
  @@index([status], map: "idx_bookings_status")
  @@map("bookings")
}

model BookingStatusHistory {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId       BigInt   @map("booking_id") @db.UnsignedBigInt
  status          String   @db.VarChar(50)
  changedByUserId BigInt?  @map("changed_by_user_id") @db.UnsignedBigInt
  changedAt       DateTime @default(now()) @map("changed_at") @db.DateTime(0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId], map: "idx_status_history_booking")
  @@map("booking_status_history")
}

model TutorLocation {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId  BigInt   @map("booking_id") @db.UnsignedBigInt
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.DateTime(0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, recordedAt], map: "idx_tutor_location_booking")
  @@map("tutor_locations")
}

model ProgressReport {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId           BigInt   @unique @map("booking_id") @db.UnsignedBigInt
  materialsCovered    String   @map("materials_covered") @db.Text
  /// 1-5
  understandingLevel  Int      @map("understanding_level") @db.UnsignedTinyInt
  masteredSkills      String?  @map("mastered_skills") @db.Text
  areasToImprove      String?  @map("areas_to_improve") @db.Text
  homeworkGiven       String?  @map("homework_given") @db.Text
  recommendationNotes String?  @map("recommendation_notes") @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("progress_reports")
}

// =========================
// COURSES
// =========================

model Course {
  id                BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  title             String       @db.VarChar(191)
  slug              String       @unique @db.VarChar(191)
  description       String?      @db.Text
  categoryId        BigInt       @map("category_id") @db.UnsignedBigInt
  educationLevelId  BigInt?      @map("education_level_id") @db.UnsignedBigInt
  level             CourseLevel  @default(pemula)
  price             Decimal      @default(0) @db.Decimal(12, 2)
  isFree            Boolean      @default(false) @map("is_free")
  thumbnailUrl      String?      @map("thumbnail_url") @db.VarChar(500)
  status            CourseStatus @default(draft)
  passingGrade      Decimal?     @map("passing_grade") @db.Decimal(5, 2)
  issuesCertificate Boolean      @default(false) @map("issues_certificate")
  createdByUserId   BigInt       @map("created_by_user_id") @db.UnsignedBigInt
  avgRating         Decimal      @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount       Int          @default(0) @map("review_count") @db.UnsignedInt
  createdAt         DateTime     @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  category       Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  educationLevel EducationLevel?    @relation(fields: [educationLevelId], references: [id], onDelete: Restrict)
  createdBy      User               @relation("CourseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  modules        CourseModule[]
  enrollments    CourseEnrollment[]

  @@index([status], map: "idx_courses_status")
  @@index([categoryId], map: "idx_courses_category")
  @@map("courses")
}

model CourseModule {
  id         BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  courseId   BigInt @map("course_id") @db.UnsignedBigInt
  title      String @db.VarChar(191)
  orderIndex Int    @default(0) @map("order_index") @db.UnsignedSmallInt

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@index([courseId, orderIndex], map: "idx_modules_course")
  @@map("course_modules")
}

model CourseLesson {
  id              BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  moduleId        BigInt     @map("module_id") @db.UnsignedBigInt
  title           String     @db.VarChar(191)
  type            LessonType
  contentUrl      String?    @map("content_url") @db.VarChar(500)
  contentBody     String?    @map("content_body") @db.LongText
  durationSeconds Int?       @map("duration_seconds") @db.UnsignedInt
  orderIndex      Int        @default(0) @map("order_index") @db.UnsignedSmallInt

  module                CourseModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizQuestions         QuizQuestion[]
  lessonProgress        LessonProgress[]
  quizAttempts          QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[]

  @@index([moduleId, orderIndex], map: "idx_lessons_module")
  @@map("course_lessons")
}

model QuizQuestion {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  lessonId     BigInt @map("lesson_id") @db.UnsignedBigInt
  questionText String @map("question_text") @db.Text
  orderIndex   Int    @default(0) @map("order_index") @db.UnsignedSmallInt

  lesson  CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options QuizOption[]

  @@map("quiz_questions")
}

model QuizOption {
  id         BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  questionId BigInt  @map("question_id") @db.UnsignedBigInt
  optionText String  @map("option_text") @db.VarChar(500)
  isCorrect  Boolean @default(false) @map("is_correct")

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("quiz_options")
}

model CourseEnrollment {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  courseId        BigInt           @map("course_id") @db.UnsignedBigInt
  learnerId       BigInt           @map("learner_id") @db.UnsignedBigInt
  status          EnrollmentStatus @default(active)
  progressPercent Decimal          @default(0) @map("progress_percent") @db.Decimal(5, 2)
  enrolledAt      DateTime         @default(now()) @map("enrolled_at") @db.DateTime(0)
  completedAt     DateTime?        @map("completed_at") @db.DateTime(0)

  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  learner               Learner                @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  lessonProgress        LessonProgress[]
  quizAttempts          QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  certificate           Certificate?

  @@unique([courseId, learnerId], map: "uq_enrollment")
  @@index([learnerId], map: "idx_enrollment_learner")
  @@map("course_enrollments")
}

model LessonProgress {
  id           BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  enrollmentId BigInt               @map("enrollment_id") @db.UnsignedBigInt
  lessonId     BigInt               @map("lesson_id") @db.UnsignedBigInt
  status       LessonProgressStatus @default(not_started)
  completedAt  DateTime?            @map("completed_at") @db.DateTime(0)

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId], map: "uq_lesson_progress")
  @@map("lesson_progress")
}

model QuizAttempt {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  enrollmentId BigInt   @map("enrollment_id") @db.UnsignedBigInt
  lessonId     BigInt   @map("lesson_id") @db.UnsignedBigInt
  score        Decimal  @db.Decimal(5, 2)
  passed       Boolean
  attemptedAt  DateTime @default(now()) @map("attempted_at") @db.DateTime(0)

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model AssignmentSubmission {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  enrollmentId   BigInt    @map("enrollment_id") @db.UnsignedBigInt
  lessonId       BigInt    @map("lesson_id") @db.UnsignedBigInt
  fileUrl        String    @map("file_url") @db.VarChar(500)
  feedback       String?   @db.Text
  score          Decimal?  @db.Decimal(5, 2)
  gradedByUserId BigInt?   @map("graded_by_user_id") @db.UnsignedBigInt
  submittedAt    DateTime  @default(now()) @map("submitted_at") @db.DateTime(0)
  gradedAt       DateTime? @map("graded_at") @db.DateTime(0)

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("assignment_submissions")
}

model Certificate {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  enrollmentId      BigInt   @unique @map("enrollment_id") @db.UnsignedBigInt
  certificateNumber String   @unique @map("certificate_number") @db.VarChar(50)
  fileUrl           String   @map("file_url") @db.VarChar(500)
  issuedAt          DateTime @default(now()) @map("issued_at") @db.DateTime(0)

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

// =========================
// PAYMENTS (polymorphic — pembayaran manual, tanpa payment gateway)
// =========================

model Payment {
  id               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  payableType      PayableType   @map("payable_type")
  payableId        BigInt        @map("payable_id") @db.UnsignedBigInt
  userId           BigInt        @map("user_id") @db.UnsignedBigInt
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod @default(qris)
  proofImageUrl    String?       @map("proof_image_url") @db.VarChar(500)
  status           PaymentStatus @default(menunggu_pembayaran)
  submittedAt      DateTime?     @map("submitted_at") @db.DateTime(0)
  verifiedByUserId BigInt?       @map("verified_by_user_id") @db.UnsignedBigInt
  verifiedAt       DateTime?     @map("verified_at") @db.DateTime(0)
  rejectionReason  String?       @map("rejection_reason") @db.VarChar(500)
  paidAt           DateTime?     @map("paid_at") @db.DateTime(0)
  /// Nominal refund yang harus dikembalikan admin (dihitung saat pembatalan, FR-PAY-06)
  refundAmount     Decimal?      @map("refund_amount") @db.Decimal(12, 2)
  refundNote       String?       @map("refund_note") @db.VarChar(500)
  refundedAt       DateTime?     @map("refunded_at") @db.DateTime(0)
  createdAt        DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  user       User  @relation("PaymentUser", fields: [userId], references: [id], onDelete: Restrict)
  verifiedBy User? @relation("PaymentVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: Restrict)

  @@index([payableType, payableId], map: "idx_payments_payable")
  @@index([status], map: "idx_payments_status")
  @@map("payments")
}

// =========================
// REVIEWS (polymorphic)
// =========================

model Review {
  id             BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  reviewableType ReviewableType @map("reviewable_type")
  reviewableId   BigInt         @map("reviewable_id") @db.UnsignedBigInt
  reviewerUserId BigInt         @map("reviewer_user_id") @db.UnsignedBigInt
  /// 1-5
  rating         Int            @db.UnsignedTinyInt
  comment        String?        @db.Text
  replyText      String?        @map("reply_text") @db.Text
  repliedAt      DateTime?      @map("replied_at") @db.DateTime(0)
  isHidden       Boolean        @default(false) @map("is_hidden")
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(0)

  reviewer User @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([reviewableType, reviewableId], map: "idx_reviews_reviewable")
  @@map("reviews")
}

// =========================
// NOTIFICATIONS & SETTINGS
// =========================

model Notification {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(191)
  body      String?   @db.VarChar(500)
  data      Json?
  readAt    DateTime? @map("read_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt], map: "idx_notifications_user")
  @@map("notifications")
}

model PlatformSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("platform_settings")
}
