# Base URL Learnly API yang dipanggil browser. Relatif = lewat proxy same-origin (rewrite di next.config.ts),
# dipakai di dev maupun production agar cookie refresh token first-party (aman untuk Safari).
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Origin API tujuan proxy (server-side, bukan NEXT_PUBLIC). Dev: API lokal. Production (Vercel): domain Railway,
# mis. https://learnly-api.up.railway.app — wajib ada saat build & runtime.
API_PROXY_TARGET=http://localhost:4000
# Tile peta Leaflet (OpenStreetMap, gratis)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
